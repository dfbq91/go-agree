  "cards": [
    {
      "dot": "cyan",
      "title": "Domain Layer (@go-agree/domain)",
      "items": [
        "Pure entities: ContractGeneration, ContractDocument, UserAccount, PricingConfig",
        "Value Objects: ContractId, UserId, Email, AnswerValue, QuestionOption",
        "Domain Services: PricingCalculatorService, AnswerPruningService, PaymentReferenceService",
        "Zero external runtime dependencies; purely driven by business logic"
      ]
    },
    {
      "dot": "emerald",
      "title": "Application Layer (@go-agree/application)",
      "items": [
        "Use Cases act as Inbound Ports orchestrating domain logic (e.g. GenerateContractDocumentUseCase)",
        "Defines Outbound / Driven Ports (ContractRepositoryPort, LlmContractDraftingPort, PaymentGatewayPort)",
        "Strictly depends on @go-agree/domain; completely decoupled from infrastructure details"
      ]
    },
    {
      "dot": "violet",
      "title": "Infrastructure Layer (@go-agree/infrastructure)",
      "items": [
        "Implements driven ports with concrete adapters (SupabaseContractRepository, PdfDocumentGeneratorAdapter)",
        "Integrates third-party services: Google Gemini AI SDK, Wompi Payment Gateway, Pino Logger",
        "Provides mock implementations for offline development and fast testing"
      ]
    },
    {
      "dot": "amber",
      "title": "Presentation & Composition (apps/web)",
      "items": [
        "Next.js App Router UI pages & API route handlers serve as Driving Adapters",
        "apps/web/src/lib/* acts as the Composition Root: instantiates adapters and injects them into Use Cases",
        "Enforces the Dependency Inversion Principle throughout the monorepo"
      ]
    }
  ]
}
